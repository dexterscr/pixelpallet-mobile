<?xml version="1.0" encoding="utf-8"?>
<!-- Botão-card do menu PixelPallet: fundo escuro translúcido, cantos arredondados,
     borda sutil e ripple vermelho da marca. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DEF4B4B">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3141419" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#20FFFFFF" />
        </shape>
    </item>
</ripple>
